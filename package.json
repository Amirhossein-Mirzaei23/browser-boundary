{
  "name": "browser-boundary",
  "version": "1.4.0",
  "description": "Find the oldest real browser version your website can actually run on. Detects compatibility boundaries across Chromium/Firefox/WebKit using real historical browser binaries.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "browser-boundary": "bin/browser-boundary.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "browser",
    "compatibility",
    "playwright",
    "chromium",
    "firefox",
    "webkit",
    "browserslist",
    "qa",
    "testing",
    "es-compat"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "scan": "tsx src/cli/index.ts",
    "scan:latest": "MRZ_LATEST_ONLY=1 tsx src/cli/index.ts",
    "scan:chromium": "MRZ_ENGINES=chromium tsx src/cli/index.ts",
    "scan:firefox": "MRZ_ENGINES=firefox tsx src/cli/index.ts",
    "scan:webkit": "MRZ_ENGINES=webkit tsx src/cli/index.ts",
    "test": "node --test --import tsx tests/unit/**/*.test.ts",
    "test:integration": "playwright test",
    "test:headed": "playwright test --headed",
    "test:fixtures": "node --test --import tsx tests/integration/**/*.test.ts",
    "examples:tabdeal": "tsx examples/tabdeal.ts",
    "examples:basic": "tsx examples/basic.ts",
    "pack-check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": false
    }
  },
  "optionalDependencies": {
    "@puppeteer/browsers": ">=2.0.0",
    "selenium-webdriver": "^4.46.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@types/node": "^20.0.0",
    "playwright": "^1.46.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amirhossein-Mirzaei23/browser-boundary.git"
  },
  "homepage": "https://github.com/Amirhossein-Mirzaei23/browser-boundary#readme",
  "bugs": {
    "url": "https://github.com/Amirhossein-Mirzaei23/browser-boundary/issues"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.27.7": true,
    "tsup@8.5.1": true
  },
  "dependencies": {
    "mrz-browser-compat": "^1.2.0"
  }
}
